<div class="filter-chaining-component">
  <h3>Filter Chaining Test</h3>
  
  <div class="filter-tests">
    <p><strong>Text:</strong> <span data-editable="text" data-prop="text">{{ text }}</span></p>
    <p><strong>Chained (upcase → truncate):</strong> {{ text | upcase | truncate: 20 }}</p>
    <p><strong>Chained (downcase → capitalize → append):</strong> {{ text | downcase | capitalize | append: "!" }}</p>
    <p><strong>Complex chain:</strong> {{ text | strip | downcase | replace: " ", "-" | append: ".html" }}</p>
  </div>
</div>
